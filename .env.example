# Copy this file to .env and fill in real values.
# .env is gitignored — never commit real secrets.

# --- App ---
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# --- MLflow ---
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_ARTIFACT_ROOT=./mlruns      # or an s3:// bucket URI in production
MLFLOW_MODEL_NAME=my-model
MLFLOW_MODEL_STAGE=Production      # Staging | Production

# --- Postgres (MLflow backend store) ---
POSTGRES_USER=mlflow
POSTGRES_PASSWORD=changeme
POSTGRES_DB=mlflow
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Serving app ---
API_HOST=0.0.0.0
API_PORT=8000

# --- AWS (only needed for deploy, not local dev) ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=
ECR_REPOSITORY_NAME=
ECS_CLUSTER_NAME=
ECS_SERVICE_NAME=

# --- External data source credentials (if your ingestion needs them) ---
# DATA_SOURCE_API_KEY=
